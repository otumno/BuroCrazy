  storyText: "\u0412\u044B \u0440\u043E\u0434\u0438\u043B\u0438\u0441\u044C \u0432
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u043C \u0440\u043E\u0434\u0438\u043B\u044C\u043D\u043E\u043C
    \u0434\u043E\u043C\u0435 \u2116404. \u041B\u0435\u0433\u0435\u043D\u0434\u0430
    \u0433\u043B\u0430\u0441\u0438\u0442, \u0447\u0442\u043E \u0432\u043C\u0435\u0441\u0442\u043E
    \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043A\u0440\u0438\u043A\u0430 \u0432\u044B
    \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0438 \u043E\u0442
    \u0430\u043A\u0443\u0448\u0435\u0440\u043A\u0438 \u0441\u043F\u0440\u0430\u0432\u043A\u0443
    \u043E \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0438 \u0432 \u0442\u0440\u0435\u0445
    \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u0430\u0445. \u0412\u0430\u0448\u0435
    \u0434\u0435\u0442\u0441\u0442\u0432\u043E \u0431\u044B\u043B\u043E... \u0441\u0432\u043E\u0435\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u043C.
    \u041A\u0435\u043C \u0432\u044B \u0431\u044B\u043B\u0438 \u0432 \u043F\u0435\u0441\u043E\u0447\u043D\u0438\u0446\u0435?"
