  storyText: "\u0412\u044B \u0441 \u043E\u0442\u043B\u0438\u0447\u0438\u0435\u043C
    \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0438 \u0432 \u0418\u043D\u0441\u0442\u0438\u0442\u0443\u0442
    \u0411\u044E\u0440\u043E\u043A\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432. \u0412\u0430\u0448\u0430 \u0437\u0430\u0449\u0438\u0442\u0430
    \u0434\u0438\u043F\u043B\u043E\u043C\u0430 \u0432\u043E\u0448\u043B\u0430 \u0432
    \u043B\u0435\u0433\u0435\u043D\u0434\u044B. \u041A\u0430\u043A\u043E\u0432\u0430
    \u0431\u044B\u043B\u0430 \u0442\u0435\u043C\u0430 \u0432\u0430\u0448\u0435\u0439
    \u0434\u0438\u043F\u043B\u043E\u043C\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B?"
  backgroundImage: {fileID: 0}
  characterIllustration: {fileID: 8300128826282271223, guid: af44e577471ada0479e100fe5c7946f0, type: 3}
  textColor: {r: 0, g: 0, b: 0, a: 1}
  choices:
  - choiceID: C1
    choiceText: "\u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439
      \u043E\u0447\u0435\u0440\u0435\u0434\u0438: \u043A\u0430\u043A \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043B\u044E\u0434\u0435\u0439 \u0441\u0442\u0440\u0430\u0434\u0430\u0442\u044C
      \u0438 \u0443\u043B\u044B\u0431\u0430\u0442\u044C\u0441\u044F"
    choiceIcon: {fileID: 0}
    resultImage: {fileID: 0}
    resultText: "\u041A\u043E\u043C\u0438\u0441\u0441\u0438\u044F \u0430\u043F\u043B\u043E\u0434\u0438\u0440\u043E\u0432\u0430\u043B\u0430
      \u0441\u0442\u043E\u044F. \u0412\u0430\u0448\u0430 \u0442\u0435\u043E\u0440\u0438\u044F
      \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u043A\u043B\u0438\u0435\u043D\u0442
      \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043F\u043E\u043A\u043E\u0440\u043D\u044B\u043C, \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
      \u0432\u0430\u043C \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0434\u0438\u043F\u043B\u043E\u043C
      \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043D\u0430\u0434
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0440\u0430\u0439\u043E\u043D\u043E\u043C."
    effects:
    - type: 14
      targetID: Region_Slums
      value: 0
      addInsteadOfSet: 0
    nextPageID: page_D
  - choiceID: C2
    choiceText: "\u0421\u0442\u0435\u043F\u043B\u0435\u0440 \u043A\u0430\u043A \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u0434\u043E\u043C\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0432 \u043E\u0444\u0438\u0441\u043D\u043E\u0439 \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u0438"
    choiceIcon: {fileID: 0}
    resultImage: {fileID: 0}
    resultText: "\u0411\u043B\u0435\u0441\u0442\u044F\u0449\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430!
      \u0412\u044B \u0434\u043E\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E
      \u0440\u0430\u0437\u043C\u0435\u0440 \u0441\u0442\u0435\u043F\u043B\u0435\u0440\u0430
      \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u0432\u043B\u0438\u044F\u0435\u0442
      \u043D\u0430 \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442. \u0412\u0430\u043C
      \u0434\u0430\u0436\u0435 \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0438 \u044D\u043B\u0438\u0442\u043D\u044B\u0439
      \u0434\u0438\u0432\u0430\u043D \u0437\u0430 \u0438\u043D\u043D\u043E\u0432\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
      \u043F\u043E\u0434\u0445\u043E\u0434."
    effects:
    - type: 6
      targetID: Upgrade_Sofas
      value: 0
      addInsteadOfSet: 0
    nextPageID: page_D
  - choiceID: C3
    choiceText: "\u0414\u0435\u043B\u0435\u0433\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435:
      \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C \u0441\u0442\u0430\u0436\u0435\u0440\u043E\u0432
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0437\u0430 \u0435\u0434\u0443
      (\u0431\u0435\u0437 \u0435\u0434\u044B)"
    choiceIcon: {fileID: 0}
    resultImage: {fileID: 0}
    resultText: "\u0412\u044B \u0442\u0430\u043A \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0437\u0430\u0449\u0438\u0449\u0430\u043B\u0438\u0441\u044C, \u0447\u0442\u043E
      \u0434\u0432\u043E\u0435 \u043F\u0435\u0440\u0432\u043E\u043A\u0443\u0440\u0441\u043D\u0438\u043A\u043E\u0432
      \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0432\u044B\u0437\u0432\u0430\u043B\u0438\u0441\u044C
      \u043D\u043E\u0441\u0438\u0442\u044C \u0437\u0430 \u0432\u0430\u043C\u0438
      \u043F\u043E\u0440\u0442\u0444\u0435\u043B\u044C. \u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u0430\u044F
      \u0440\u0430\u0431\u0441\u0438\u043B\u0430 \u2014 \u0437\u0430\u043B\u043E\u0433
      \u0443\u0441\u043F\u0435\u0445\u0430."
    effects:
    - type: 4
      targetID: Intern
