  thoughtPool:
  - "\u041E\u0439, \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A..."
  - "\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u0431\u0430\u0431\u0443\u0448\u043A\u0435."
  - "\u0414\u0430\u0432\u043D\u043E \u044F \u0442\u0443\u0442 \u043D\u0435 \u0431\u044B\u043B\u0430."
  - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435, \u043C\u0438\u043B\u044B\u0439!"
  - "\u0414\u0430\u0439 \u0431\u043E\u0433 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."
  grumblingLines:
  - "\u042D\u0442\u043E \u043D\u0435\u0441\u043D\u043E\u0441\u043D\u043E!"
  - "\u0412\u043E\u0442 \u0431\u0435\u0434\u0441\u0442\u0432\u0438\u0435!"
  - "\u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F
