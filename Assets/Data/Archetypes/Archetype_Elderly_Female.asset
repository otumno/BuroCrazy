  - "\u041E\u0439, \u0434\u0435\u043B\u0430-\u0430-\u0430..."
  - "\u0422\u044F\u0436\u0435\u043B\u043E \u0441\u0442\u043E\u044F\u0442\u044C-\u0442\u043E."
  happyResponses:
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u043C\u0438\u043B\u044B\u0439!"
  - "\u0411\u043E\u0433 \u0442\u0435\u0431\u044F \u043D\u0430\u0433\u0440\u0430\u0434\u0438\u0442!"
  - "\u0412\u043E\u0442 \u0441\u043F\u0430\u0441\u0438\u0431\u043E\u0447\u043A\u043E!"
  - "\u0414\u0430\u0439 \u0431\u043E\u0433 \u0442\u0435\u0431\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F!"
  - "\u0423\u043C\u043D\u0438\u0446\u0430 \u0442\u044B, \u0441\u044B\u043D\u043E\u043A!"
  angryResponses:
  - "\u041D\u0443 \u0438 \u043D\u0443, \u043C\u043E\u043B\u043E\u0434\u0451\u0436\u044C..."
  - "\u042D\u0445, \u043B\u0443\u0447\u0448\u0435 \u0431\u044B \u0434\u043E\u043C\u0430
    \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C."
