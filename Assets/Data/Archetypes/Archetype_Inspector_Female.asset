  thoughtPool:
  - "\u0412\u0441\u0451 \u043F\u043E \u0440\u0435\u0433\u043B\u0430\u043C\u0435\u043D\u0442\u0443."
  - "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u043F\u0440\u0435\u0432\u044B\u0448\u0435
    \u0432\u0441\u0435\u0433\u043E."
  - "\u041D\u0430\u0434\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C."
  - "\u0411\u0435\u0437 \u0431\u0443\u043C\u0430\u0436\u043A\u0438 \u2014 \u0431\u0443\u043A\u0430\u0448\u043A\u0430."
