  grumblingLines:
  - "\u041D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u044B."
  - "\u042F \u0431\u0443\u0434\u0443 \u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C\u0441\u044F."
  - "\u042D\u0442\u043E \u043D\u0435 \u043F\u043E \u0443\u0441\u0442\u0430\u0432\u0443."
  - "\u041F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u0442\u044C."
  - "\u0413\u0434\u0435 \u0433\u0435\u0440\u0431\u043E\u0432\u0430\u044F \u043F\u0435\u0447\u0430\u0442\u044C?"
  happyResponses:
  - "\u041F\u043E\u0440\u044F\u0434\u043E\u043A."
  - "\u0412\u0441\u0451 \u0432\u0435\u0440\u043D\u043E."
  - "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E."
  - "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
