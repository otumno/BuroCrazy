  - "\u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F."
  angryResponses:
  - "\u0411\u0435\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u0435."
  - "\u042F \u044D\u0442\u043E \u0442\u0430\u043A \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044E."
  - "\u0414\u043E\u043B\u043E\u0436\u0443 \u043D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u0443."
  - "\u041D\u0435\u043A\u043E\u043C\u043F\u0435\u0442\u0435\u043D\u0442\u043D\u043E\u0441\u0442\u044C."
