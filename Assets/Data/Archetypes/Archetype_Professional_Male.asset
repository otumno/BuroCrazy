  - "\u0422\u0430\u043A \u043D\u0435 \u043F\u043E\u0439\u0434\u0451\u0442."
  - "\u0413\u0434\u0435 \u043F\u0435\u0447\u0430\u0442\u044C?"
  happyResponses:
  - "\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E."
  - "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E."
  - "\u0412\u0441\u0451 \u0432\u0435\u0440\u043D\u043E."
