  - "\u0412\u0440\u0435\u043C\u044F \u0442\u0435\u0440\u043F\u0438\u0442."
  - "\u0421\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435."
  grumblingLines:
  - "\u042D\u0442\u043E \u043D\u0435 \u043F\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0443."
  - "\u042F \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u044E \u043D\u0430 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435."
