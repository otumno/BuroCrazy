  allowedGoals: 0f00000008000000
  thoughtPool:
  - "\u0412\u0440\u0435\u043C\u044F \u2014 \u0434\u0435\u043D\u044C\u0433\u0438."
  - "\u0423\u0441\u043F\u0435\u0442\u044C \u0431\u044B \u043D\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0443."
  - "\u041A\u043B\u0438\u0435\u043D\u0442\u043A\u0430 \u0436\u0434\u0451\u0442."
  - "\u0411\u044B\u0441\u0442\u0440\u0435\u0435 \u0431\u044B."
  - "\u0413\u0434\u0435 \u043C\u043E\u0439 \u043A\u043E\u0444\u0435?"
  grumblingLines:
  - "\u042D\u0442\u043E \u0432\u043E\u0437\u043C\u0443\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E."
  - "\u042F \u0442\u0435\u0440\u044F\u044E \u0434\u0435\u043D\u044C\u0433\u0438."
  - "\u0412\u0430\u0448\u0430 \u0431\u044E\u0440\u043E\u043A\u0440\u0430\u0442\u0438\u044F..."
  - "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u0436\u043D\u043E \u0436\u0434\u0430\u0442\u044C?"
  - "\u042F \u0431\u0443\u0434\u0443 \u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C\u0441\u044F."
  happyResponses:
  - "\u041E\u0442\u043B\u0438\u0447\u043D\u043E."
  - "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E."
  - "\u041E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u043E."
  - "\u041F\u0440\u0438\u044F\u0442\u043D\u043E \u0438\u043C\u0435\u0442\u044C \u0434\u0435\u043B\u043E."
  - "\u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437
    \u0442\u043E\u043B\u044C\u043A\u043E \u043A \u0432\u0430\u043C."
  angryResponses:
  - "\u0420\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0430."
  - "\u0422\u0435\u0440\u044F\u044E \u0432\u0440\u0435\u043C\u044F."
  - "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u0431\u043E\u043B\u044C\u0448\u0435."
  - "\u0423\u0436\u0430\u0441\u043D\u044B\u0439 \u0441\u0435\u0440\u0432\u0438\u0441."
