  speakerID: Operator
  text: 
  speakerPortrait: {fileID: 0}
  voiceClip: {fileID: 0}
  variantTexts:
  - "\u0426\u0438\u0440\u043A \u0441\u043B\u0443\u0448\u0430\u0435\u0442!"
  - "\u0412\u044B \u0434\u043E\u0437\u0432\u043E\u043D\u0438\u043B\u0438\u0441\u044C
    \u0432 \u0426\u0438\u0440\u043A \u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0412\u044B\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0445 \u0428\u0443\u0442\u043E\u043A
    \u0438 \u042E\u043C\u043E\u0440\u0435\u0441\u043E\u043A. \u0412\u0441\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
    \u0448\u0443\u0442\u043A\u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0442
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C\u0443
    \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0443."
  - "\u0410\u043B\u043B\u043E, \u044D\u0442\u043E \u0446\u0438\u0440\u043A. \u0412\u0430\u043C
    \u043A\u043B\u043E\u0443\u043D\u043E\u0432 \u0438\u043B\u0438 \u0430\u043A\u0440\u043E\u0431\u0430\u0442\u043E\u0432?"
  - "\u0421\u043B\u0443\u0436\u0431\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438
    \u0441\u043C\u0435\u0445\u0430. \u0427\u0435\u0433\u043E \u0438\u0437\u0432\u043E\u043B\u0438\u0442\u0435?"
