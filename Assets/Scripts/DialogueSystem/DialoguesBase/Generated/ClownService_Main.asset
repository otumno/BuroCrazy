  speakerPortrait: {fileID: 0}
  voiceClip: {fileID: 0}
  variantTexts:
  - "\u041D\u0430\u0448 \u0430\u0440\u0442\u0438\u0441\u0442 \u0443\u0436\u0435 \u043C\u0447\u0438\u0442\u0441\u044F!
    \u0421\u043A\u043E\u0440\u043E \u0432\u0441\u0435 \u0431\u0443\u0434\u0443\u0442
    \u0441\u043C\u0435\u044F\u0442\u044C\u0441\u044F."
  - "\u041A\u043B\u043E\u0443\u043D \u0432\u044B\u0435\u0445\u0430\u043B. \u0413\u043E\u0442\u043E\u0432\u044C\u0442\u0435
    \u043D\u043E\u0441\u044B \u0438 \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435."
  - "\u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u0434\u044A\u0435\u0434\u0435\u0442.
    \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u043F\u043E\u0445\u043B\u043E\u043F\u0430\u0442\u044C,
    \u043E\u043D\u0438 \u044D\u0442\u043E \u043E\u0431\u043E\u0436\u0430\u044E\u0442."
