  speakerID: Secretary
  text: "\u041D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437, \u0432\u0432\u0438\u0434\u0443
    \u043E\u0441\u0442\u0440\u043E\u0439 \u043D\u0435\u0445\u0432\u0430\u0442\u043A\u0438
    \u043A\u0430\u0434\u0440\u043E\u0432, \u041C\u0438\u043D\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
