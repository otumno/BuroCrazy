  speakerID: Secretary
  text: "\u0422\u0440\u0443\u0449\u043E\u0431\u044B \u0442\u0435\u043F\u0435\u0440\u044C
    \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u043F\u043E\u0434
    \u043D\u0430\u0448\u0435\u0439 \u044E\u0440\u0438\u0441\u0434\u0438\u043A\u0446\u0438\u0435\u0439.
    \u042F \u0441\u043D\u0438\u043C\u0430\u044E \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0443
    \u0441 \u0432\u0445\u043E\u0434\u043D\u044B\u0445 \u0434\u0432\u0435\u0440\u0435\u0439.
    \u0421\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u0439\u0434\u0443\u0442 \u043F\u0435\u0440\u0432\u044B\u0435
    \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0438!"
