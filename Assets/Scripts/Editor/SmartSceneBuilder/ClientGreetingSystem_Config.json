        "triggerChance": 0.1,
        "checkInterval": 5.0,
        "sceneCooldown": 120.0,
        "allowedArchetypes": [],
        "excludeArchetypes": ["Guard", "Director"],
        "lines": [
          { "speakerArchetypeID": "", "requiredGender": -1, "text": "Вы не в очередь встали!" },
