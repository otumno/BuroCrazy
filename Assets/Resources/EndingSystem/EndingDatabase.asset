  endings:
  - endingID: Law
    displayName: "\u0416\u0435\u043B\u0435\u0437\u043D\u0430\u044F \u0440\u0443\u043A\u0430"
    description: "\u0412\u044B \u043D\u0430\u0432\u043E\u0434\u0438\u0442\u0435 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439 \u0440\u0443\u043A\u043E\u0439.
      \u0411\u044E\u0440\u043E \u0441\u0442\u0430\u043B\u043E \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u043C
      \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u044B \u0438 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u043D\u0438\u044F.\n\n\u0424\u0438\u043D\u0430\u043B
      \u043A\u0430\u0440\u044C\u0435\u0440\u044B: \u0417\u0430\u043A\u043E\u043D
      \u043F\u0440\u0435\u0432\u044B\u0448\u0435 \u0432\u0441\u0435\u0433\u043E."
    endingImage: {fileID: 0}
    endingMusic: {fileID: 0}
    endingDialogue: {fileID: 0}
    endingCinematic: {fileID: 0}
    isDismissal: 0
  - endingID: Empathy
    displayName: "\u0414\u0443\u0448\u0430 \u0431\u044E\u0440\u043E"
    description: "\u0412\u044B \u2014 \u0432\u043E\u043F\u043B\u043E\u0449\u0435\u043D\u0438\u0435
      \u0441\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043D\u0438\u044F. \u041F\u043E\u0434
      \u0432\u0430\u0448\u0438\u043C \u043D\u0430\u0447\u0430\u043B\u043E\u043C \u0411\u044E\u0440\u043E
      \u0441\u0442\u0430\u043B\u043E \u043C\u0435\u0441\u0442\u043E\u043C, \u0433\u0434\u0435
      \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u044E
      \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442.\n\n\u0424\u0438\u043D\u0430\u043B
      \u043A\u0430\u0440\u044C\u0435\u0440\u044B: \u0414\u043E\u0431\u0440\u043E\u0442\u0430
      \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442."
    endingImage: {fileID: 0}
    endingMusic: {fileID: 0}
    endingDialogue: {fileID: 0}
    endingCinematic: {fileID: 0}
    isDismissal: 0
  - endingID: Mask
    displayName: "\u0411\u0435\u0437\u043B\u0438\u043A\u0438\u0439"
    description: "\u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u0435\u0442,
      \u043A\u0442\u043E \u0432\u044B \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
      \u0434\u0435\u043B\u0435. \u0412\u0430\u0448\u0438 \u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
      \u0431\u0435\u0437 \u0441\u043B\u0435\u0434\u0430.\n\n\u0424\u0438\u043D\u0430\u043B
      \u043A\u0430\u0440\u044C\u0435\u0440\u044B: \u0422\u0435\u043D\u044C \u0411\u044E\u0440\u043E."
    endingImage: {fileID: 0}
    endingMusic: {fileID: 0}
    endingDialogue: {fileID: 0}
    endingCinematic: {fileID: 0}
    isDismissal: 0
  - endingID: Ambition
    displayName: "\u041A\u0430\u0440\u044C\u0435\u0440\u0438\u0441\u0442"
    description: "\u0412\u0430\u0448 \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043C\u043E\u0442\u0438\u0432
      \u2014 \u0432\u043B\u0430\u0441\u0442\u044C. \u0412\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438
      \u0411\u044E\u0440\u043E \u043A\u0430\u043A \u0442\u0440\u0430\u043C\u043F\u043B\u0438\u043D
      \u0434\u043B\u044F \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.\n\n\u0424\u0438\u043D\u0430\u043B
      \u043A\u0430\u0440\u044C\u0435\u0440\u044B: \u0412\u0435\u0440\u0448\u0438\u043D\u0430
      \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u0430."
    endingImage: {fileID: 0}
    endingMusic: {fileID: 0}
    endingDialogue: {fileID: 0}
    endingCinematic: {fileID: 0}
    isDismissal: 0
  - endingID: Dismissal
    displayName: "\u041E\u0442\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435"
    description: "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435! \u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440
      \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u0451\u043D \u043E\u0442 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438
      \u0437\u0430 \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u043E\u0433\u043E
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043E\u0448\u0438\u0431\u043E\u043A.\n\n\u0411\u044E\u0440\u043E
      \u0437\u0430\u043A\u0440\u044B\u0442\u043E \u043D\u0430 \u043F\u0435\u0440\u0435\u0430\u0442\u0442\u0435\u0441\u0442\u0430\u0446\u0438\u044E."
    endingImage: {fileID: 0}
    endingMusic: {fileID: 0}
    endingDialogue: {fileID: 0}
    endingCinematic: {fileID: 0}
    isDismissal: 1
