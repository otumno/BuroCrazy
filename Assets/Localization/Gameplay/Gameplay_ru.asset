    m_Metadata:
      m_Items: []
  - m_Id: 350921899892761
    m_Localized: "\u043C\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u044F \u043F\u043E\u0434
      \u0433\u0443\u043B \u043F\u0440\u0438\u043D\u0442\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 350921899892762
    m_Localized: "\u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0434\u0438\u0430\u0433\u0440\u0430\u043C\u043C \u0432 Excel \u043E \u0441\u043C\u044B\u0441\u043B\u0435
      \u0436\u0438\u0437\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 350921899892763
    m_Localized: "\u0421\u0447\u0438\u0442\u0430\u0435\u0442, \u0447\u0442\u043E
      \u043F\u0440\u0438\u043D\u0442\u0435\u0440 - \u044D\u0442\u043E \u043F\u043E\u0440\u0442\u0430\u043B
      \u0432 \u0434\u0440\u0443\u0433\u043E\u0435 \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 350921899892764
    m_Localized: "\u0423\u0431\u0435\u0436\u0434\u0435\u043D, \u0447\u0442\u043E
      \u043A\u043E\u043C\u043D\u0430\u0442\u043D\u044B\u0439 \u0444\u0438\u043A\u0443\u0441
      - \u0435\u0433\u043E \u043F\u0440\u044F\u043C\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 350921899892765
    m_Localized: "\u0420\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u0441 \u043A\u0443\u043B\u0435\u0440\u043E\u043C \u0434\u043B\u044F \u0432\u043E\u0434\u044B,
      \u043A\u043E\u0433\u0434\u0430 \u0434\u0443\u043C\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0435\u0433\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0438\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 350921899892766
    m_Localized: "\u0412\u0435\u0440\u0438\u0442, \u0447\u0442\u043E \u0442\u0440\u043E\u0439\u043D\u0430\u044F
      \u043A\u043E\u043F\u0438\u044F \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430
      \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0441\u0438\u043B\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 350921899892767
    m_Localized: "\u041F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0432 \u043F\u043E\u0434\u0432\u0430\u043B\u0435 \u0436\u0438\u0432\u0435\u0442
      \u0440\u0443\u0447\u043D\u043E\u0439 \u0430\u0440\u0445\u0438\u0432\u0430\u0442\u043E\u0440."
    m_Metadata:
      m_Items: []
