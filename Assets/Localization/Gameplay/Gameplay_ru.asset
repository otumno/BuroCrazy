  - m_Id: 367147623637018
    m_Localized: "\u041F\u0420\u0418\u041A\u0410\u0417 \u041E \u041F\u041E\u0412\u042B\u0428\u0415\u041D\u0418\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 367147623637019
    m_Localized: "\u041F\u0420\u0418\u041A\u0410\u0417 \u041E \u041D\u0410\u0417\u041D\u0410\u0427\u0415\u041D\u0418\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 367147623637020
    m_Localized: "\u041F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u0434\u043E \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438:"
    m_Metadata:
      m_Items: []
  - m_Id: 367147623637021
    m_Localized: "\u041D\u0430\u0437\u043D\u0430\u0447\u0438\u0442\u044C \u043D\u0430
      \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C:"
    m_Metadata:
      m_Items: []
  - m_Id: 367147623637022
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C, \u0432\u0432\u0438\u0434\u0443
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438
      \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u043F\u0430\u0440\u0430\u0433\u0440\u0430\u0444\u0443
      7-\u0411\u0418\u0421 \u0443\u0441\u0442\u0430\u0432\u0430, \u043F\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044F\u0435\u0442\u0441\u044F:"
    m_Metadata:
      m_Items: []
  - m_Id: 367147623637023
    m_Localized: "\u0412 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438
      \u0441 \u0434\u0438\u0440\u0435\u043A\u0442\u0438\u0432\u043E\u0439 \u21161337
      \u043E \u043A\u0430\u0434\u0440\u043E\u0432\u044B\u0445 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430\u0445
      \u0438 \u0432 \u0446\u0435\u043B\u044F\u0445 \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u0438
      \u0440\u0430\u0431\u043E\u0447\u0438\u0445 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432,
      \u043F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u044E:"
    m_Metadata:
      m_Items: []
  - m_Id: 367147623637024
    m_Localized: "\u0420\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0432 \u043B\u0438\u0447\u043D\u043E\u0435
      \u0434\u0435\u043B\u043E \u0438 \u043F\u0440\u0438\u043D\u044F\u0432 \u0432\u043E
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0435\u043E\u0446\u0435\u043D\u0438\u043C\u044B\u0439
      \u0432\u043A\u043B\u0430\u0434 \u0432 \u0431\u043E\u0440\u044C\u0431\u0443
      \u0441 \u044D\u043D\u0442\u0440\u043E\u043F\u0438\u0435\u0439, \u0440\u0435\u0448\u0435\u043D\u043E:"
    m_Metadata:
      m_Items: []
  - m_Id: 367147623637025
    m_Localized: "\u0412\u043E \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u043A\u0430\u0437\u0430 \u043E \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0438
      \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
      \u0438 \u043F\u043E \u0438\u0442\u043E\u0433\u0430\u043C \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u044C\u043D\u043E\u0439
      \u0430\u0442\u0442\u0435\u0441\u0442\u0430\u0446\u0438\u0438, \u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442:"
    m_Metadata:
      m_Items: []
  - m_Id: 367147623637026
    m_Localized: "\u041F\u041E\u0421\u0422 \u041E\u0425\u0420\u0410\u041D\u042B"
