  m_TableData:
  - m_Id: 122900439040
    m_Localized: Returning to workstation
    m_Metadata:
      m_Items: []
  - m_Id: 122942382080
    m_Localized: Done!
    m_Metadata:
      m_Items: []
  - m_Id: 122942382081
    m_Localized: That didn't work...
    m_Metadata:
      m_Items: []
  - m_Id: 122942382082
    m_Localized: Dropping everything!
    m_Metadata:
      m_Items: []
  - m_Id: 122942382083
    m_Localized: Um... Director!
    m_Metadata:
      m_Items: []
  - m_Id: 122942382084
    m_Localized: The desk is broken!
    m_Metadata:
      m_Items: []
  - m_Id: 122942382085
    m_Localized: 'The desk is broken!

      Call the janitor!'
    m_Metadata:
      m_Items: []
  - m_Id: 122942382086
    m_Localized: 'Wrong form.

      Please get the right one.'
    m_Metadata:
      m_Items: []
  - m_Id: 122942382087
    m_Localized: Checking...
    m_Metadata:
      m_Items: []
  - m_Id: 122942382088
    m_Localized: 'There''s an error!

      Please fill it out again.'
    m_Metadata:
      m_Items: []
  - m_Id: 122942382089
    m_Localized: Processing (Cat. 1)...
    m_Metadata:
      m_Items: []
  - m_Id: 122942382090
    m_Localized: Processing (Cat. 2)...
    m_Metadata:
      m_Items: []
  - m_Id: 122942382091
    m_Localized: Done! Please go to the cashier.
    m_Metadata:
      m_Items: []
  - m_Id: 122942382092
    m_Localized: The cash register is broken!
    m_Metadata:
      m_Items: []
  - m_Id: 122942382093
    m_Localized: 'Amount due: ${0}'
    m_Metadata:
      m_Items:
      - rid: 1506924130828025945
  - m_Id: 122950770688
    m_Localized: No one will notice...
    m_Metadata:
      m_Items: []
  - m_Id: 122950770689
    m_Localized: Service payment ({0})
    m_Metadata:
      m_Items:
      - rid: 1506924130828025945
  - m_Id: 122950770690
    m_Localized: Share of the skim ({0})
    m_Metadata:
      m_Items:
      - rid: 1506924130828025945
  - m_Id: 122950770691
    m_Localized: Bribe
    m_Metadata:
      m_Items: []
  - m_Id: 122950770692
    m_Localized: There's an error... I'll fix it.
    m_Metadata:
      m_Items: []
  - m_Id: 122950770693
    m_Localized: Filing...
    m_Metadata:
      m_Items: []
  - m_Id: 122950770694
    m_Localized: The counter is broken!
    m_Metadata:
      m_Items: []
  - m_Id: 122950770695
    m_Localized: Ticket #{0}, please step forward!
    m_Metadata:
      m_Items:
      - rid: 1506924130828025945
  - m_Id: 122950770696
    m_Localized: Please join the queue!
    m_Metadata:
      m_Items: []
  - m_Id: 122950770697
    m_Localized: Typical bureaucrats...
    m_Metadata:
      m_Items: []
  - m_Id: 122950770698
    m_Localized: All right, hand over your documents...
    m_Metadata:
      m_Items: []
  - m_Id: 122950770699
    m_Localized: Where is the visitor?
    m_Metadata:
      m_Items: []
  - m_Id: 122950770700
    m_Localized: How long do I have to wait?!
    m_Metadata:
      m_Items: []
  - m_Id: 122950770701
    m_Localized: 'Waiting for: {0}

      {1} ({2:F0} s)'
    m_Metadata:
      m_Items:
      - rid: 1506924130828025945
  - m_Id: 122950770702
    m_Localized: 'Serving at: {0}

      {1}'
    m_Metadata:
      m_Items:
      - rid: 1506924130828025945
  - m_Id: 122950770703
    m_Localized: No show. Next!
    m_Metadata:
      m_Items: []
  - m_Id: 122950770704
    m_Localized: Hello.
    m_Metadata:
      m_Items: []
  - m_Id: 122950770705
    m_Localized: How can I help?
    m_Metadata:
      m_Items: []
  - m_Id: 122950770706
    m_Localized: What brings you here?
    m_Metadata:
      m_Items: []
  - m_Id: 122950770707
    m_Localized: What do you need?
    m_Metadata:
      m_Items: []
  - m_Id: 122950770708
    m_Localized: Your documents, please.
    m_Metadata:
      m_Items: []
  - m_Id: 122950770709
    m_Localized: One moment, let me check...
    m_Metadata:
      m_Items: []
  - m_Id: 122950770710
    m_Localized: Uh... probably that way...
    m_Metadata:
      m_Items: []
  - m_Id: 122950770711
    m_Localized: 'Please go to:

      ''{0}'''
    m_Metadata:
      m_Items:
      - rid: 1506924130828025945
  - m_Id: 122950770712
    m_Localized: Got it, thank you.
    m_Metadata:
      m_Items: []
  - m_Id: 122950770713
    m_Localized: I need an archive record.
    m_Metadata:
      m_Items: []
  - m_Id: 122950770714
    m_Localized: 'The archivist is away!

      Please come back later.'
    m_Metadata:
      m_Items: []
  - m_Id: 122950770715
    m_Localized: Intern, fetch a record from the archive!
    m_Metadata:
      m_Items: []
  - m_Id: 122950770716
    m_Localized: All right, I'll wait in the hall...
    m_Metadata:
      m_Items: []
  - m_Id: 122950770717
    m_Localized: 'Requesting an archive record.

      Please wait.'
    m_Metadata:
      m_Items: []
  - m_Id: 122950770718
    m_Localized: Where is it...
    m_Metadata:
      m_Items: []
  - m_Id: 122950770719
    m_Localized: Still waiting!
    m_Metadata:
      m_Items: []
  - m_Id: 122950770720
    m_Localized: This is taking forever...
    m_Metadata:
      m_Items: []
  - m_Id: 122950770721
    m_Localized: Has the archive fallen asleep?
    m_Metadata:
      m_Items: []
  - m_Id: 122950770722
    m_Localized: 'No response from the archive...

      Sorry.'
    m_Metadata:
      m_Items: []
  - m_Id: 122950770723
    m_Localized: I need a certificate.
    m_Metadata:
      m_Items: []
  - m_Id: 122950770724
    m_Localized: I'm filing form 2.
    m_Metadata:
      m_Items: []
  - m_Id: 122950770725
    m_Localized: I'm here to pay my taxes.
    m_Metadata:
      m_Items: []
  - m_Id: 122950770726
    m_Localized: I need the archive.
    m_Metadata:
      m_Items: []
  - m_Id: 122950770727
    m_Localized: Where's the toilet?
    m_Metadata:
      m_Items: []
  - m_Id: 122950770728
    m_Localized: I need the director's signature!
    m_Metadata:
      m_Items: []
  - m_Id: 122950770729
    m_Localized: I have an appointment with the director!
    m_Metadata:
      m_Items: []
  - m_Id: 122950770730
    m_Localized: I'd like a certificate, please...
    m_Metadata:
      m_Items: []
  - m_Id: 122950770731
    m_Localized: Next
    m_Metadata:
      m_Items: []
  - m_Id: 5782589399040
    m_Localized: Looking for the archive record...
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593344
    m_Localized: Here is your archive record.
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593345
    m_Localized: Get on it immediately!
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593346
    m_Localized: I am busy!
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593347
    m_Localized: I am busy right now!
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593348
    m_Localized: 'Everything is broken here!

      I cannot work.'
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593349
    m_Localized: The desk broke!
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593350
    m_Localized: Next!
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593351
    m_Localized: You there, step forward!
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593352
    m_Localized: Sorry, boss...
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593353
    m_Localized: All right, hand it over...
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593354
    m_Localized: Bribe to the director
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593355
    m_Localized: Very well, hand it over...
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593356
    m_Localized: Right, this order...
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593357
    m_Localized: 'Nobody at registration...

      I will register it myself.'
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593358
    m_Localized: Stamping the document.
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593359
    m_Localized: Paying my own fee...
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593360
    m_Localized: Registration fee
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593361
    m_Localized: And finally, to the archive!
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593362
    m_Localized: Too late...
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593363
    m_Localized: 'The desk is piled high!

      Taking papers to the archive...'
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593364
    m_Localized: Putting papers down...
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593365
    m_Localized: I will collect the documents...
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593366
    m_Localized: Where is the folder?!
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593367
    m_Localized: Delivering...
    m_Metadata:
      m_Items: []
  - m_Id: 5782593593368
    m_Localized: No desk for reports!
    m_Metadata:
      m_Items: []
